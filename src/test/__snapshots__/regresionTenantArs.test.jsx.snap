exports[`tenant en pesos sin secundaria (sin-provider) > Carrito 1`] = `"<div class="cp-root cp-surface cp-no-scrollbar" data-pantalla="carrito" style="position: fixed; inset: 0px; width: 100%; z-index: 240; overflow-y: auto; padding-bottom: 130px;"><div style="padding: 16px 14px 10px; display: flex; align-items: center; gap: 10px; position: sticky; top: 0px; background: var(--bg); z-index: 5; border-bottom: 1px solid var(--line);"><button style="width: 38px; height: 38px; border-radius: 999px; background: transparent; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--tx); cursor: pointer;" aria-label="Atras"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M19 12H5m0 0 6-6m-6 6 6 6"></path></svg></button><div style="flex: 1 1 0%;"><div style="font-family: var(--font-heading); font-size: 18px; color: var(--tx);">Mi pedido</div><div class="body-s" style="font-size: 11px;">3 productos</div></div></div><div style="padding: 16px 22px 4px;"><h1 class="h-2" style="margin: 0px;">Revisa lo que <em style="font-style: italic; color: var(--t2);">te llevas</em></h1></div><div data-parte="lista" style="padding: 8px 22px 0px;"><div style="display: flex; gap: 14px; padding: 16px 0px; border-bottom: 1px solid var(--line);"><div style="width: 72px; height: 72px; flex-shrink: 0; border-radius: 12px; overflow: hidden; background: rgb(138, 74, 48);"></div><div style="flex: 1 1 0%; min-width: 0px;"><div style="font-family: var(--font-heading); font-size: 16px; color: var(--tx); line-height: 1.2; margin-bottom: 6px;">Pan de campo</div><div style="display: flex; align-items: center; justify-content: space-between; margin-top: 8px;"><div style="display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 999px; overflow: hidden;"><button style="width: 28px; height: 28px; background: transparent; border: 0px; color: var(--tx); cursor: pointer; display: flex; align-items: center; justify-content: center;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M5 12h14"></path></svg></button><span style="min-width: 22px; text-align: center; font-weight: 600; font-size: 13px;">2</span><button style="width: 28px; height: 28px; background: transparent; border: 0px; color: var(--tx); cursor: pointer; display: flex; align-items: center; justify-content: center;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M12 5v14M5 12h14"></path></svg></button></div><span style="font-family: var(--font-body); font-weight: 600; font-size: 15px; color: var(--tx);">$3.000</span></div></div></div><div style="display: flex; gap: 14px; padding: 16px 0px; border-bottom: medium;"><div style="width: 72px; height: 72px; flex-shrink: 0; border-radius: 12px; overflow: hidden; background: rgb(138, 74, 48);"></div><div style="flex: 1 1 0%; min-width: 0px;"><div style="font-family: var(--font-heading); font-size: 16px; color: var(--tx); line-height: 1.2; margin-bottom: 6px;">Torta de ricota</div><div style="display: flex; align-items: center; justify-content: space-between; margin-top: 8px;"><div style="display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 999px; overflow: hidden;"><button style="width: 28px; height: 28px; background: transparent; border: 0px; color: var(--tx); cursor: pointer; display: flex; align-items: center; justify-content: center;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M6 6l12 12M18 6 6 18"></path></svg></button><span style="min-width: 22px; text-align: center; font-weight: 600; font-size: 13px;">1</span><button style="width: 28px; height: 28px; background: transparent; border: 0px; color: var(--tx); cursor: pointer; display: flex; align-items: center; justify-content: center;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M12 5v14M5 12h14"></path></svg></button></div><span style="font-family: var(--font-body); font-weight: 600; font-size: 15px; color: var(--tx);">$4.200,5</span></div></div></div><button style="width: 100%; margin-top: 14px; height: 44px; border-radius: 12px; border: 1.5px dashed var(--line); background: transparent; color: var(--t2); font-family: var(--font-body); font-size: 13px; font-weight: 500; cursor: pointer;">+ Seguir agregando productos</button></div><div style="padding: 20px 22px 0px;"><div style="background: color-mix(in oklab, var(--ac) 12%, var(--bg)); border: 1px solid var(--ac); border-radius: 12px; padding: 12px 14px;"><div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: 12.5px;"><span style="font-weight: 600; color: var(--ac);">Faltan $799,5 para el minimo</span><span style="color: var(--t3); font-size: 11px;">$5.200,5 / $6.000</span></div><div style="height: 6px; background: var(--b2); border-radius: 999px; overflow: hidden;"><div style="height: 100%; width: 87%; background: var(--ac); transition: width 240ms var(--ease);"></div></div></div></div><div data-parte="subtotal" style="padding: 20px 22px 12px;"><div style="background: var(--b2); border-radius: 14px; padding: 18px;"><div class="caption" style="margin-bottom: 12px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--t3);">Subtotal</div><div style="display: flex; align-items: baseline; justify-content: space-between;"><span style="font-size: 13px; color: var(--t2);">3 productos</span><span style="font-family: var(--font-heading); font-size: 28px; color: var(--tx);">$5.200,5</span></div><p style="margin: 10px 0px 0px; font-size: 11px; color: var(--t3); line-height: 1.4;">Envío, cupón y propina se calculan en el siguiente paso.</p></div><div style="margin-top: 12px; background: var(--b2); border-radius: 14px; padding: 14px 16px;"><label style="font-size: 12px; color: var(--t3); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; display: block; margin-bottom: 8px;">Notas para la cocina</label><textarea maxlength="300" placeholder="Sin sal, sin cebolla, bien cocido..." style="width: 100%; min-height: 60px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--tx); font-family: inherit; font-size: 13px; resize: vertical; outline: none; box-sizing: border-box;"></textarea><div style="text-align: right; font-size: 10.5px; color: var(--t3); margin-top: 2px;">0/300</div></div></div><div style="padding: 12px 22px 8px;"><div style="margin-bottom: 12px;"><div class="caption" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--t3);">Sumale algo extra</div><h3 style="margin: 4px 0px 0px; font-family: var(--font-heading); font-size: 20px; color: var(--tx);">Lo mas <em style="font-style: italic; color: var(--ac);">pedido</em></h3></div><div class="cp-no-scrollbar" style="display: flex; gap: 12px; overflow-x: auto; padding-bottom: 4px;"><div style="flex: 0 0 140px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); overflow: hidden; display: flex; flex-direction: column;"><div style="height: 90px; background: rgb(208, 133, 82); overflow: hidden;"></div><div style="padding: 8px 10px; display: flex; flex-direction: column; gap: 6px; flex: 1 1 0%;"><div style="font-family: var(--font-heading); font-size: 13px; color: var(--tx); line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 32px;">Z</div><div style="display: flex; align-items: center; justify-content: space-between; margin-top: auto;"><span style="font-size: 13px; font-weight: 600; color: var(--tx);">$900</span><button type="button" style="width: 28px; height: 28px; border-radius: 999px; border: 0px; background: var(--ac); color: rgb(255, 255, 255); cursor: pointer; display: flex; align-items: center; justify-content: center;" aria-label="Agregar"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M12 5v14M5 12h14"></path></svg></button></div></div></div></div></div><div style="position: fixed; left: 0px; right: 0px; bottom: 0px; z-index: 50; background: var(--bg); border-top: 1px solid var(--line);"><button data-parte="continuar" disabled="" style="width: 100%; height: 56px; border-radius: var(--rs); border: 0px; background: var(--b2); color: var(--t3); cursor: not-allowed; display: flex; align-items: center; justify-content: space-between; padding-left: 22px; padding-right: 18px; font-family: var(--font-body);"><span style="display: flex; flex-direction: column; align-items: flex-start; line-height: 1.2;"><span style="font-size: 11px; opacity: 0.85; font-weight: 400;">Continuar al pago</span><span style="font-size: 15px; font-weight: 600;">3 items</span></span><span style="display: flex; align-items: center; gap: 8px;"><span style="font-family: var(--font-heading); font-size: 22px;">$5.200,5</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M5 12h14m0 0-6-6m6 6-6 6"></path></svg></span></button></div></div>"`;

exports[`tenant en pesos sin secundaria (sin-provider) > Checkout paso 1 1`] = `"<div class="cp-root cp-surface cp-no-scrollbar" data-pantalla="checkout" data-paso="entrega" style="position: fixed; inset: 0px; z-index: 240; overflow-y: auto; padding-bottom: 130px;"><div data-parte="encabezado" style="position: sticky; top: 0px; z-index: 5; background: var(--bg); border-bottom: 1px solid var(--line); padding: 14px 18px 12px; display: flex; align-items: center; gap: 12px;"><button aria-label="Atras" style="width: 38px; height: 38px; border-radius: 999px; background: transparent; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--tx); cursor: pointer; flex-shrink: 0;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M19 12H5m0 0 6-6m-6 6 6 6"></path></svg></button><div style="flex: 1 1 0%; font-family: var(--font-heading); font-size: 18px; color: var(--tx);">Entrega</div><span style="font-size: 11px; color: var(--t3); font-weight: 600;">2/3</span></div><div data-parte="indicador" style="display: flex; align-items: center; justify-content: space-between; padding: 16px 22px 4px; gap: 8px;"><div style="flex: 1 1 0%; display: flex; flex-direction: column; align-items: center; gap: 4px;"><div style="width: 26px; height: 26px; border-radius: 50%; background: var(--ac); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; border: 1px solid var(--line);">✓</div><span style="font-size: 10px; color: var(--t3); font-weight: 400;">Datos</span></div><div aria-current="step" style="flex: 1 1 0%; display: flex; flex-direction: column; align-items: center; gap: 4px;"><div style="width: 26px; height: 26px; border-radius: 50%; background: var(--ac); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; border: 2px solid var(--ac);">2</div><span style="font-size: 10px; color: var(--tx); font-weight: 600;">Entrega</span></div><div style="flex: 1 1 0%; display: flex; flex-direction: column; align-items: center; gap: 4px;"><div style="width: 26px; height: 26px; border-radius: 50%; background: var(--b2); color: var(--t3); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; border: 1px solid var(--line);">3</div><span style="font-size: 10px; color: var(--t3); font-weight: 400;">Pago</span></div></div><div style="padding: 18px 22px 0px;"><div style="margin-bottom: 20px;"><label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--t2); margin-bottom: 10px;">¿Cómo lo recibís?</label><div style="display: flex; flex-direction: column; gap: 10px;"><button type="button" style="width: 100%; padding: 14px 16px; text-align: left; background: var(--bg); border: 1.5px solid var(--line); border-radius: 14px; cursor: pointer; font-family: inherit; display: flex; align-items: center; gap: 12px;"><div style="flex: 1 1 0%;"><div style="font-weight: 700; font-size: 14px; color: var(--tx);">Retiro en local</div><div style="font-size: 12px; color: var(--t2); margin-top: 2px; line-height: 1.4;">Dirección del local</div></div></button><button type="button" style="width: 100%; padding: 14px 16px; text-align: left; background: var(--ac-soft, var(--b2)); border: 1.5px solid var(--ac); border-radius: 14px; cursor: pointer; font-family: inherit; display: flex; align-items: center; gap: 12px;"><div style="flex: 1 1 0%;"><div style="font-weight: 700; font-size: 14px; color: var(--tx);">Delivery</div><div style="font-size: 12px; color: var(--t2); margin-top: 2px; line-height: 1.4;">Te lo llevamos a tu dirección</div></div><div style="width: 22px; height: 22px; border-radius: 50%; background: var(--ac); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">✓</div></button></div></div><div style="margin-bottom: 20px;"><label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--t2); margin-bottom: 10px;">Direccion de entrega</label><input style="width: 100%; height: 46px; padding: 0px 14px; background: var(--bg); color: var(--tx); border: 1px solid var(--line); border-radius: 12px; font-family: inherit; font-size: 14px; outline: none; box-sizing: border-box;" placeholder="Calle y numero (Ej: Av. San Martin 1234)" value="Calle 1"><button style="margin-top: 10px; width: 100%; padding: 11px 14px; background: transparent; border: 1.5px dashed var(--line); border-radius: 10px; font-size: 13px; font-weight: 600; color: var(--ac); cursor: pointer; font-family: inherit;">Usar mi ubicacion actual</button><input style="width: 100%; height: 46px; padding: 0px 14px; background: var(--bg); color: var(--tx); border: 1px solid var(--line); border-radius: 12px; font-family: inherit; font-size: 14px; outline: none; box-sizing: border-box; margin-top: 10px;" placeholder="Piso / Depto (opcional)"><input style="width: 100%; height: 46px; padding: 0px 14px; background: var(--bg); color: var(--tx); border: 1px solid var(--line); border-radius: 12px; font-family: inherit; font-size: 14px; outline: none; box-sizing: border-box; margin-top: 10px;" placeholder="Referencia para el delivery (timbre, esquina...)"><div style="margin-top: 10px; font-size: 12.5px; color: var(--t2); font-weight: 600;">Envío gratis en compras de más de $5.000</div><div style="margin-top: 12px; padding: 12px 14px; background: var(--b2); border-radius: 12px; border: 1px solid var(--line);"><div style="display: flex; justify-content: space-between; align-items: center;"><div><div style="font-size: 13px; font-weight: 700; color: var(--tx);">Costo de envío</div><div style="font-size: 11px; color: var(--t3); margin-top: 2px;">~3 km desde el local</div></div><div style="font-size: 18px; font-weight: 800; color: var(--ac);">$700</div></div></div></div><button data-parte="siguiente" style="width: 100%; margin-top: 24px; height: 52px; border-radius: 14px; border: 0px; background: var(--ac); color: rgb(255, 255, 255); font-family: inherit; font-size: 15px; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;">Siguiente<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M5 12h14m0 0-6-6m6 6-6 6"></path></svg></button></div></div>"`;

exports[`tenant en pesos sin secundaria (sin-provider) > Checkout paso 2 1`] = `"<div class="cp-root cp-surface cp-no-scrollbar" data-pantalla="checkout" data-paso="pago" style="position: fixed; inset: 0px; z-index: 240; overflow-y: auto; padding-bottom: 130px;"><div data-parte="encabezado" style="position: sticky; top: 0px; z-index: 5; background: var(--bg); border-bottom: 1px solid var(--line); padding: 14px 18px 12px; display: flex; align-items: center; gap: 12px;"><button aria-label="Atras" style="width: 38px; height: 38px; border-radius: 999px; background: transparent; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--tx); cursor: pointer; flex-shrink: 0;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M19 12H5m0 0 6-6m-6 6 6 6"></path></svg></button><div style="flex: 1 1 0%; font-family: var(--font-heading); font-size: 18px; color: var(--tx);">Pago</div><span style="font-size: 11px; color: var(--t3); font-weight: 600;">3/3</span></div><div data-parte="indicador" style="display: flex; align-items: center; justify-content: space-between; padding: 16px 22px 4px; gap: 8px;"><div style="flex: 1 1 0%; display: flex; flex-direction: column; align-items: center; gap: 4px;"><div style="width: 26px; height: 26px; border-radius: 50%; background: var(--ac); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; border: 1px solid var(--line);">✓</div><span style="font-size: 10px; color: var(--t3); font-weight: 400;">Datos</span></div><div style="flex: 1 1 0%; display: flex; flex-direction: column; align-items: center; gap: 4px;"><div style="width: 26px; height: 26px; border-radius: 50%; background: var(--ac); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; border: 1px solid var(--line);">✓</div><span style="font-size: 10px; color: var(--t3); font-weight: 400;">Entrega</span></div><div aria-current="step" style="flex: 1 1 0%; display: flex; flex-direction: column; align-items: center; gap: 4px;"><div style="width: 26px; height: 26px; border-radius: 50%; background: var(--ac); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; border: 2px solid var(--ac);">3</div><span style="font-size: 10px; color: var(--tx); font-weight: 600;">Pago</span></div></div><div style="padding: 18px 22px 0px;"><div style="margin-bottom: 20px;"><label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--t2); margin-bottom: 10px;">Medio de pago</label><div style="display: flex; flex-direction: column; gap: 10px;"><button type="button" style="width: 100%; padding: 14px 16px; text-align: left; background: var(--ac-soft, var(--b2)); border: 1.5px solid var(--ac); border-radius: 14px; cursor: pointer; font-family: inherit; display: flex; align-items: center; gap: 12px;"><span style="font-size: 22px;">💵</span><div style="flex: 1 1 0%;"><div style="font-weight: 700; font-size: 14px; color: var(--tx);">Efectivo</div><div style="font-size: 12px; color: var(--t2); margin-top: 2px; line-height: 1.4;">Pagás al recibir</div></div><div style="width: 22px; height: 22px; border-radius: 50%; background: var(--ac); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">✓</div></button><button type="button" style="width: 100%; padding: 14px 16px; text-align: left; background: var(--bg); border: 1.5px solid var(--line); border-radius: 14px; cursor: pointer; font-family: inherit; display: flex; align-items: center; gap: 12px;"><span style="font-size: 22px;">🏦</span><div style="flex: 1 1 0%;"><div style="font-weight: 700; font-size: 14px; color: var(--tx);">Banco</div><div style="font-size: 12px; color: var(--t2); margin-top: 2px; line-height: 1.4;">Alias: a.b</div></div></button></div></div><div style="margin-top: -10px; margin-bottom: 20px; padding: 16px 18px; background: var(--b2); border: 1px solid var(--line); border-radius: 14px;"><div style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--t2); margin-bottom: 10px;">¿Con cuanto pagas?</div><div style="display: flex; gap: 10px;"><button type="button" style="flex: 1 1 0%; padding: 12px 14px; border-radius: 12px; background: var(--ac); color: rgb(255, 255, 255); border: 1px solid var(--ac); font-weight: 700; font-size: 14px; cursor: pointer; font-family: inherit;">Pago justo</button><button type="button" style="flex: 1 1 0%; padding: 12px 14px; border-radius: 12px; background: var(--b2); color: var(--tx); border: 1px solid var(--line); font-weight: 700; font-size: 14px; cursor: pointer; font-family: inherit;">Necesito cambio</button></div></div><div style="margin-bottom: 20px;"><label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--t2); margin-bottom: 10px;">Propina para la cocina</label><p style="font-size: 11.5px; color: var(--t3); margin: 0px 0px 10px;">Opcional. 100% va para el equipo.</p><div style="display: flex; gap: 6px;"><button type="button" style="flex: 1 1 0%; height: 44px; border-radius: 10px; background: transparent; color: var(--t2); border: 1px solid var(--line); font-family: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer;">No</button><button type="button" style="flex: 1 1 0%; height: 44px; border-radius: 10px; background: var(--tx); color: var(--bg); border: 1px solid var(--tx); font-family: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer;">5%</button><button type="button" style="flex: 1 1 0%; height: 44px; border-radius: 10px; background: transparent; color: var(--t2); border: 1px solid var(--line); font-family: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer;">10%</button><button type="button" style="flex: 1 1 0%; height: 44px; border-radius: 10px; background: transparent; color: var(--t2); border: 1px solid var(--line); font-family: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer;">15%</button><button type="button" style="flex: 1 1 0%; height: 44px; border-radius: 10px; background: transparent; color: var(--t2); border: 1px solid var(--line); font-family: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer;">20%</button><button type="button" style="flex: 1 1 0%; height: 44px; border-radius: 10px; background: transparent; color: var(--t2); border: 1px solid var(--line); font-family: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer;">Otro</button></div><p style="font-size: 11px; color: var(--ok, #2A9D6E); margin: 8px 0px 0px 2px;">Dejás <strong>$300</strong> de propina</p></div><div style="margin-bottom: 20px;"><label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--t2); margin-bottom: 10px;">¿Tenés un cupón?</label><div style="display: flex; gap: 8px; align-items: center; border: 1px solid var(--line); border-radius: 12px; padding: 4px; background: var(--bg);"><input disabled="" placeholder="Ingresá tu cupón" style="flex: 1 1 0%; height: 40px; border: 0px; padding: 0px 12px; background: transparent; font-family: monospace; font-size: 13px; color: var(--tx); outline: none; letter-spacing: 0.05em;" value="X"><button style="height: 38px; padding: 0px 14px; border-radius: 8px; border: 0px; background: var(--ok, #2A9D6E); color: rgb(255, 255, 255); font-weight: 700; font-size: 13px; cursor: pointer;">✓ -5%</button></div><p style="font-size: 11px; color: var(--ok, #2A9D6E); margin: 6px 0px 0px 2px;">Descuento 5% — ahorrás $100</p></div><div style="margin-bottom: 20px; padding: 14px 16px; background: var(--b2); border-radius: 12px; border: 1px solid var(--line);"><div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--t3); margin-bottom: 6px;">Productos</div><div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0px; border-bottom: 1px solid var(--line);"><div style="flex: 1 1 0%; min-width: 0px;"><span style="font-weight: 600; color: var(--tx);">Pan de campo</span><span style="color: var(--t3); font-size: 12px;"> x2</span></div><span style="font-weight: 700; color: var(--tx);">$3.000</span></div><div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0px; border-bottom: 1px solid var(--line);"><div style="flex: 1 1 0%; min-width: 0px;"><span style="font-weight: 600; color: var(--tx);">Torta de ricota</span><span style="color: var(--t3); font-size: 12px;"> x1</span></div><span style="font-weight: 700; color: var(--tx);">$4.200,5</span></div><div style="display: flex; justify-content: space-between; padding: 10px 0px; font-size: 13px;"><span style="color: var(--t2);">Envío (~3 km)</span><span style="font-weight: 700; color: var(--tx);">$700</span></div><div style="display: flex; justify-content: space-between; padding: 6px 0px; font-size: 12px; color: var(--ok, #2A9D6E);"><span>Cupón -5%</span><span>−$100</span></div><div style="display: flex; justify-content: space-between; padding: 6px 0px; font-size: 13px; color: var(--t2);"><span>Propina (5%)</span><span style="color: var(--tx);">$300</span></div><hr style="margin: 10px 0px; border-top: 1px solid var(--line); border-right: 0px; border-bottom: 0px; border-left: 0px; border-image: none;"><div style="display: flex; justify-content: space-between; align-items: baseline;"><span style="font-size: 14px; font-weight: 600; color: var(--tx);">Total a pagar</span><span style="font-family: var(--font-heading); font-size: 26px; color: var(--tx);">$7.900,5</span></div></div><div style="margin-bottom: 20px;"><div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--t3); margin-bottom: 6px;">Entrega</div><div style="font-size: 14px; color: var(--tx); margin-top: 2px;">Delivery — Calle 1</div></div><div style="margin-bottom: 20px;"><div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--t3); margin-bottom: 6px;">Tus datos</div><div style="font-size: 14px; color: var(--tx); margin-top: 2px;">Ana</div><div style="font-size: 12px; color: var(--t3); margin-top: 2px;">1155 · a@a.com</div></div><button data-parte="completar" style="width: 100%; padding: 12px 16px; background: var(--ok, #2A9D6E); color: rgb(255, 255, 255); border: 0px; border-radius: 12px; font-family: inherit; font-size: 16px; font-weight: 700; cursor: pointer; height: 56px;">Completar pedido</button></div></div>"`;

exports[`tenant en pesos sin secundaria (sin-provider) > Ficha con opciones 1`] = `"<div class="cp-root cp-surface cp-no-scrollbar" data-pantalla="ficha" style="position: fixed; inset: 0px; width: 100%; z-index: 240; overflow-y: auto; padding-bottom: 110px;"><div data-parte="foto" style="position: relative; height: 320px;"><div style="position: relative; width: 100%; height: 320px; background: rgb(138, 74, 48); border-radius: 0px; overflow: hidden;"><div style="position: absolute; inset: 0px; background: linear-gradient(135deg, rgb(138, 74, 48) 0%, color-mix(in oklab, rgb(138, 74, 48) 70%, rgb(0, 0, 0)) 100%); opacity: 1; transition: opacity 240ms ease;"></div></div><div style="position: absolute; top: 0px; left: 0px; right: 0px; height: 120px; background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, transparent 100%);"></div><div style="position: absolute; bottom: 0px; left: 0px; right: 0px; height: 100px; background: linear-gradient(180deg, transparent 0%, var(--bg) 100%);"></div></div><div style="position: fixed; top: 0px; left: 0px; right: 0px; z-index: 30; padding: 16px 14px 10px; background: transparent; border-bottom: 1px solid transparent; transition: all 220ms var(--ease); display: flex; align-items: center; justify-content: space-between; pointer-events: none;"><button style="width: 38px; height: 38px; border-radius: 999px; pointer-events: auto; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(8px); border: 0px; color: rgb(45, 27, 14); display: flex; align-items: center; justify-content: center; cursor: pointer;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M19 12H5m0 0 6-6m-6 6 6 6"></path></svg></button><button style="width: 38px; height: 38px; border-radius: 999px; pointer-events: auto; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(8px); border: 0px; color: rgb(45, 27, 14); display: flex; align-items: center; justify-content: center; cursor: pointer;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10Z"></path></svg></button></div><div style="padding: 0px 22px; margin-top: -36px; position: relative; z-index: 2;"><h1 data-parte="titulo" style="font-family: var(--font-heading); font-size: 34px; line-height: 1.25; letter-spacing: -0.01em; margin: 0px 0px 10px; padding-bottom: 0.06em; color: var(--tx);">Bandeja</h1><p data-parte="descripcion" class="body-l" style="color: var(--t2); margin: 0px; font-size: 15px;">x</p><div style="display: flex; align-items: center; gap: 16px; margin-top: 16px; flex-wrap: wrap;"><div style="display: inline-flex; align-items: center; gap: 4px; font-size: 12px; color: var(--t2);"><svg width="11" height="11" viewBox="0 0 24 24" fill="var(--ac)" aria-hidden="true"><path d="M12 2 14.5 8.5 21 9 16 14l1.5 7L12 17l-5.5 4L8 14 3 9l6.5-.5L12 2Z"></path></svg><span style="font-weight: 600; color: var(--tx);">4.3</span><span style="color: var(--t3);">(133)</span></div></div></div><hr style="margin: 24px 22px 0px; border-top: 1px solid var(--line); border-right: 0px; border-bottom: 0px; border-left: 0px; border-image: none;"><div data-parte="opciones" style="padding: 20px 22px 0px; display: flex; flex-direction: column; gap: 24px;"><fieldset id="opt-g" style="border: 0px; margin: 0px; padding: 0px; min-width: 0px;"><legend style="padding: 0px; width: 100%;"><span style="display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px;"><span style="font-family: var(--font-heading); font-size: 20px; color: var(--tx);">Extras</span><span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; flex-shrink: 0; color: var(--t2); text-decoration: none;">Opcional</span></span></legend><div style="display: flex; flex-direction: column; gap: 10px;"><label style="display: flex; align-items: center; gap: 12px; padding: 10px 16px; min-height: 52px; border: 1.5px solid var(--line); background: var(--bg); border-radius: 14px; cursor: pointer; opacity: 1; transition: border-color 150ms, background 150ms;"><input style="accent-color: var(--ac); width: 20px; height: 20px; cursor: inherit; flex-shrink: 0;" type="checkbox" name="opt-g"><span style="flex: 1 1 0%; min-width: 0px; font-weight: 600; font-size: 14.5px; color: var(--tx);">Queso</span><span style="font-weight: 700; font-size: 14px; color: var(--t2); flex-shrink: 0;">+$150</span></label></div></fieldset></div><div style="padding: 24px 22px 0px;"><h3 style="margin: 0px 0px 6px; font-family: var(--font-heading); font-size: 20px; color: var(--tx);">Notas para la cocina</h3><p class="body-s" style="margin-top: 0px; margin-bottom: 12px;">Algo que tengamos en cuenta. Hacemos lo posible — no garantizamos cambios mayores.</p><textarea placeholder="Sin sal · cocción jugosa · sin cebolla…" maxlength="140" style="width: 100%; min-height: 80px; padding: 14px; resize: none; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: var(--tx); font-family: var(--font-body); font-size: 14px; line-height: 1.5; outline: none;"></textarea><div style="text-align: right; font-size: 11px; color: var(--t3); margin-top: 4px;">0/140</div></div><div style="padding: 32px 22px 0px;"><div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px;"><h3 style="margin: 0px; font-family: var(--font-heading); font-size: 20px; color: var(--tx);">Qué dicen</h3></div><div style="display: flex; align-items: center; gap: 22px; padding: 16px 18px; background: var(--b2); border-radius: 14px;"><div><div style="font-family: var(--font-heading); font-size: 36px; line-height: 1; color: var(--tx);">4.3</div><div class="body-s" style="font-size: 11px; margin-top: 4px;">133 opiniones</div></div><div style="flex: 1 1 0%; display: flex; flex-direction: column; gap: 4px;"><div style="display: flex; align-items: center; gap: 8px; font-size: 10px;"><span style="width: 8px; color: var(--t2);">5</span><div style="flex: 1 1 0%; height: 4px; background: var(--b3); border-radius: 2px; overflow: hidden;"><div style="width: 78%; height: 100%; background: var(--ac);"></div></div><span style="width: 26px; text-align: right; color: var(--t3);">78%</span></div><div style="display: flex; align-items: center; gap: 8px; font-size: 10px;"><span style="width: 8px; color: var(--t2);">4</span><div style="flex: 1 1 0%; height: 4px; background: var(--b3); border-radius: 2px; overflow: hidden;"><div style="width: 16%; height: 100%; background: var(--ac);"></div></div><span style="width: 26px; text-align: right; color: var(--t3);">16%</span></div><div style="display: flex; align-items: center; gap: 8px; font-size: 10px;"><span style="width: 8px; color: var(--t2);">3</span><div style="flex: 1 1 0%; height: 4px; background: var(--b3); border-radius: 2px; overflow: hidden;"><div style="width: 4%; height: 100%; background: var(--ac);"></div></div><span style="width: 26px; text-align: right; color: var(--t3);">4%</span></div><div style="display: flex; align-items: center; gap: 8px; font-size: 10px;"><span style="width: 8px; color: var(--t2);">2</span><div style="flex: 1 1 0%; height: 4px; background: var(--b3); border-radius: 2px; overflow: hidden;"><div style="width: 1%; height: 100%; background: var(--ac);"></div></div><span style="width: 26px; text-align: right; color: var(--t3);">1%</span></div><div style="display: flex; align-items: center; gap: 8px; font-size: 10px;"><span style="width: 8px; color: var(--t2);">1</span><div style="flex: 1 1 0%; height: 4px; background: var(--b3); border-radius: 2px; overflow: hidden;"><div style="width: 1%; height: 100%; background: var(--ac);"></div></div><span style="width: 26px; text-align: right; color: var(--t3);">1%</span></div></div></div></div><div style="position: fixed; left: 0px; right: 0px; bottom: 0px; z-index: 50; width: 100%; background: var(--bg); border-top: 1px solid var(--line); display: flex; align-items: center; gap: 12px;"><div style="display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; background: var(--bg);"><button type="button" style="width: 44px; height: 44px; border: 0px; background: transparent; color: var(--t2); cursor: pointer; display: flex; align-items: center; justify-content: center;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M5 12h14"></path></svg></button><div style="min-width: 24px; text-align: center; font-weight: 600; font-size: 14px;">1</div><button type="button" style="width: 44px; height: 44px; border: 0px; background: transparent; color: var(--tx); cursor: pointer; display: flex; align-items: center; justify-content: center;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M12 5v14M5 12h14"></path></svg></button></div><button data-parte="agregar" style="flex: 1 1 0%; height: 52px; border-radius: var(--rs); border: 0px; background: var(--ac); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: space-between; padding-left: 18px; padding-right: 14px; cursor: pointer; font-family: var(--font-body); font-weight: 500; font-size: 15px;"><span>Agregar al pedido</span><span style="font-family: var(--font-heading); font-size: 15px;">$1.700</span></button></div></div>"`;

exports[`tenant en pesos sin secundaria (sin-provider) > Pedidos 1`] = `"<div class="cp-root cp-surface cp-no-scrollbar" style="position: fixed; inset: 0px; width: 100%; z-index: 230; overflow-y: auto; padding-bottom: 110px;"><div style="padding: 16px 22px 8px; position: sticky; top: 0px; background: var(--bg); z-index: 5;"><h1 class="h-1" style="margin: 0px; font-size: 32px;">Tus pedidos</h1></div><div style="display: flex; gap: 8px; padding: 8px 22px 16px;"><button style="height: 36px; padding: 0px 16px; border-radius: 999px; border: 1px solid var(--tx); background: var(--tx); color: var(--bg); font-family: var(--font-body); font-size: 13px; font-weight: 500; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">Activos</button><button style="height: 36px; padding: 0px 16px; border-radius: 999px; border: 1px solid var(--line); background: transparent; color: var(--t2); font-family: var(--font-body); font-size: 13px; font-weight: 500; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">Anteriores</button></div><div style="padding: 40px; text-align: center; color: var(--t3); font-size: 13px;">Cargando…</div><style>@keyframes cp-pulse { 0%,100% { opacity: 1 } 50% { opacity: 0.3 } }</style></div>"`;
