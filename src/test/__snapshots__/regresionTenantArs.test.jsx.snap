</div></div><div style="position: fixed; left: 0px; right: 0px; bottom: 0px; z-index: 50; width: 100%; background: var(--bg); border-top: 1px solid var(--line); display: flex; align-items: center; gap: 12px;"><div style="display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; background: var(--bg);"><button type="button" style="width: 44px; height: 44px; border: 0px; background: transparent; color: var(--t2); cursor: pointer; display: flex; align-items: center; justify-content: center;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M5 12h14"></path></svg></button><div style="min-width: 24px; text-align: center; font-weight: 600; font-size: 14px;">1</div><button type="button" style="width: 44px; height: 44px; border: 0px; background: transparent; color: var(--tx); cursor: pointer; display: flex; align-items: center; justify-content: center;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M12 5v14M5 12h14"></path></svg></button></div><button data-parte="agregar" style="flex: 1 1 0%; height: 52px; border-radius: var(--rs); border: 0px; background: var(--ac); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: space-between; padding-left: 18px; padding-right: 14px; cursor: pointer; font-family: var(--font-body); font-weight: 500; font-size: 15px;"><span>Agregar al pedido</span><span style="font-family: var(--font-heading); font-size: 15px;">$1.700</span></button></div></div>"`;

