exports[`tenant en pesos sin secundaria (ars) > Carrito 1`] = `"<div class="cp-root cp-surface cp-no-scrollbar" data-pantalla="carrito" style="position: fixed; inset: 0px; width: 100%; z-index: 240; overflow-y: auto; padding-bottom: 130px;"><div style="padding: 16px 14px 10px; display: flex; align-items: center; gap: 10px; position: sticky; top: 0px; background: var(--bg); z-index: 5; border-bottom: 1px solid var(--line);"><button style="width: 38px; height: 38px; border-radius: 999px; background: transparent; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--tx); cursor: pointer;" aria-label="Atras"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M19 12H5m0 0 6-6m-6 6 6 6"></path></svg></button><div style="flex: 1 1 0%;"><div style="font-family: var(--font-heading); font-size: 18px; color: var(--tx);">Mi pedido</div><div class="body-s" style="font-size: 11px;">3 productos</div></div></div><div style="padding: 16px 22px 4px;"><h1 class="h-2" style="margin: 0px;">Revisa lo que <em style="font-style: italic; color: var(--t2);">te llevas</em></h1></div><div data-parte="lista" style="padding: 8px 22px 0px;"><div style="display: flex; gap: 14px; padding: 16px 0px; border-bottom: 1px solid var(--line);"><div style="width: 72px; height: 72px; flex-shrink: 0; border-radius: 12px; overflow: hidden; background: rgb(138, 74, 48);"></div><div style="flex: 1 1 0%; min-width: 0px;"><div style="font-family: var(--font-heading); font-size: 16px; color: var(--tx); line-height: 1.2; margin-bottom: 6px;">Pan de campo</div><div style="display: flex; align-items: center; justify-content: space-between; margin-top: 8px;"><div style="display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 999px; overflow: hidden;"><button style="width: 28px; height: 28px; background: transparent; border: 0px; color: var(--tx); cursor: pointer; display: flex; align-items: center; justify-content: center;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M5 12h14"></path></svg></button><span style="min-width: 22px; text-align: center; font-weight: 600; font-size: 13px;">2</span><button style="width: 28px; height: 28px; background: transparent; border: 0px; color: var(--tx); cursor: pointer; display: flex; align-items: center; justify-content: center;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M12 5v14M5 12h14"></path></svg></button></div><span style="font-family: var(--font-body); font-weight: 600; font-size: 15px; color: var(--tx);">$3.000</span></div></div></div><div style="display: flex; gap: 14px; padding: 16px 0px; border-bottom: medium;"><div style="width: 72px; height: 72px; flex-shrink: 0; border-radius: 12px; overflow: hidden; background: rgb(138, 74, 48);"></div><div style="flex: 1 1 0%; min-width: 0px;"><div style="font-family: var(--font-heading); font-size: 16px; color: var(--tx); line-height: 1.2; margin-bottom: 6px;">Torta de ricota</div><div style="display: flex; align-items: center; justify-content: space-between; margin-top: 8px;"><div style="display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 999px; overflow: hidden;"><button style="width: 28px; height: 28px; background: transparent; border: 0px; color: var(--tx); cursor: pointer; display: flex; align-items: center; justify-content: center;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M6 6l12 12M18 6 6 18"></path></svg></button><span style="min-width: 22px; text-align: center; font-weight: 600; font-size: 13px;">1</span><button style="width: 28px; height: 28px; background: transparent; border: 0px; color: var(--tx); cursor: pointer; display: flex; align-items: center; justify-content: center;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M12 5v14M5 12h14"></path></svg></button></div><span style="font-family: var(--font-body); font-weight: 600; font-size: 15px; color: var(--tx);">$4.200,5</span></div></div></div><button style="width: 100%; margin-top: 14px; height: 44px; border-radius: 12px; border: 1.5px dashed var(--line); background: transparent; color: var(--t2); font-family: var(--font-body); font-size: 13px; font-weight: 500; cursor: pointer;">+ Seguir agregando productos</button></div><div style="padding: 20px 22px 0px;"><div style="background: color-mix(in oklab, var(--ac) 12%, var(--bg)); border: 1px solid var(--ac); border-radius: 12px; padding: 12px 14px;"><div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: 12.5px;"><span style="font-weight: 600; color: var(--ac);">Faltan $799,5 para el minimo</span><span style="color: var(--t3); font-size: 11px;">$5.200,5 / $6.000</span></div><div style="height: 6px; background: var(--b2); border-radius: 999px; overflow: hidden;"><div style="height: 100%; width: 87%; background: var(--ac); transition: width 240ms var(--ease);"></div></div></div></div><div data-parte="subtotal" style="padding: 20px 22px 12px;"><div style="background: var(--b2); border-radius: 14px; padding: 18px;"><div class="caption" style="margin-bottom: 12px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--t3);">Subtotal</div><div style="display: flex; align-items: baseline; justify-content: space-between;"><span style="font-size: 13px; color: var(--t2);">3 productos</span><span style="font-family: var(--font-heading); font-size: 28px; color: var(--tx);">$5.200,5</span></div><p style="margin: 10px 0px 0px; font-size: 11px; color: var(--t3); line-height: 1.4;">Envío, cupón y propina se calculan en el siguiente paso.</p></div><div style="margin-top: 12px; background: var(--b2); border-radius: 14px; padding: 14px 16px;"><label style="font-size: 12px; color: var(--t3); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; display: block; margin-bottom: 8px;">Notas para la cocina</label><textarea maxlength="300" placeholder="Sin sal, sin cebolla, bien cocido..." style="width: 100%; min-height: 60px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--tx); font-family: inherit; font-size: 13px; resize: vertical; outline: none; box-sizing: border-box;"></textarea><div style="text-align: right; font-size: 10.5px; color: var(--t3); margin-top: 2px;">0/300</div></div></div><div style="padding: 12px 22px 8px;"><div style="margin-bottom: 12px;"><div class="caption" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--t3);">Sumale algo extra</div><h3 style="margin: 4px 0px 0px; font-family: var(--font-heading); font-size: 20px; color: var(--tx);">Lo mas <em style="font-style: italic; color: var(--ac);">pedido</em></h3></div><div class="cp-no-scrollbar" style="display: flex; gap: 12px; overflow-x: auto; padding-bottom: 4px;"><div style="flex: 0 0 140px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); overflow: hidden; display: flex; flex-direction: column;"><div style="height: 90px; background: rgb(208, 133, 82); overflow: hidden;"></div><div style="padding: 8px 10px; display: flex; flex-direction: column; gap: 6px; flex: 1 1 0%;"><div style="font-family: var(--font-heading); font-size: 13px; color: var(--tx); line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 32px;">Z</div><div style="display: flex; align-items: center; justify-content: space-between; margin-top: auto;"><span style="font-size: 13px; font-weight: 600; color: var(--tx);">$900</span><button type="button" style="width: 28px; height: 28px; border-radius: 999px; border: 0px; background: var(--ac); color: rgb(255, 255, 255); cursor: pointer; display: flex; align-items: center; justify-content: center;" aria-label="Agregar"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M12 5v14M5 12h14"></path></svg></button></div></div></div></div></div><div style="position: fixed; left: 0px; right: 0px; bottom: 0px; z-index: 50; background: var(--bg); border-top: 1px solid var(--line);"><button data-parte="continuar" disabled="" style="width: 100%; height: 56px; border-radius: var(--rs); border: 0px; background: var(--b2); color: var(--t3); cursor: not-allowed; display: flex; align-items: center; justify-content: space-between; padding-left: 22px; padding-right: 18px; font-family: var(--font-body);"><span style="display: flex; flex-direction: column; align-items: flex-start; line-height: 1.2;"><span style="font-size: 11px; opacity: 0.85; font-weight: 400;">Continuar al pago</span><span style="font-size: 15px; font-weight: 600;">3 items</span></span><span style="display: flex; align-items: center; gap: 8px;"><span style="font-family: var(--font-heading); font-size: 22px;">$5.200,5</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M5 12h14m0 0-6-6m6 6-6 6"></path></svg></span></button></div></div>"`;

exports[`tenant en pesos sin secundaria (ars) > Checkout paso 1 1`] = `"<div class="cp-root cp-surface cp-no-scrollbar" data-pantalla="checkout" data-paso="entrega" style="position: fixed; inset: 0px; z-index: 240; overflow-y: auto; padding-bottom: 130px;"><div data-parte="encabezado" style="position: sticky; top: 0px; z-index: 5; background: var(--bg); border-bottom: 1px solid var(--line); padding: 14px 18px 12px; display: flex; align-items: center; gap: 12px;"><button aria-label="Atras" style="width: 38px; height: 38px; border-radius: 999px; background: transparent; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--tx); cursor: pointer; flex-shrink: 0;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display: block;"><path d="M19 12H5m0 0 6-6m-6 6 6 6"></path></svg></button><div style="flex: 1 1 0%; font-family: var(--font-heading); font-size: 18px; color: var(--tx);">Entrega</div><span style="font-size: 11px; color: var(--t3); font-weight: 600;">2/3</span></div><div data-parte="indicador" style="display: flex; align-items: center; justify-content: space-between; padding: 16px 22px 4px; gap: 8px;"><div style="flex: 1 1 0%; display: flex; flex-direction: column; align-items: center; gap: 4px;"><div style="width: 26px; height: 26px; border-radius: 50%; background: var(--ac); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; border: 1px solid var(--line);">✓</div><span style="font-size: 10px; color: var(--t3); font-weight: 400;">Datos</span></div><div aria-current="step" style="flex: 1 1 0%; display: flex; flex-direction: column; align-items: center; gap: 4px;"><div style="width: 26px; height: 26px; border-radius: 50%; background: var(--ac); color: rgb(255, 255, 255); display: flex; align-items: center; justify-content: center; font-siz